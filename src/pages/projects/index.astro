---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { projects } from '../../data/projects';

const workCompanies = ['TikTok', 'Shopee'];
const workProjects = projects.filter((p) => workCompanies.includes(p.company));
const independentProjects = projects.filter((p) => !workCompanies.includes(p.company));
---

<BaseLayout
  title="Projects"
  description="Selected projects by Jiangge Wu — distributed systems at TikTok and Shopee, iOS apps, and independent products."
>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <SectionHeading
      title="Projects"
      subtitle="A selection of projects that reflect my technical interests and approach to building software."
    />

    <h3 class="mb-4 text-lg font-semibold text-surface-900 dark:text-surface-100">Work Projects</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      {workProjects.map((project) => {
        const isTodo = project.description.startsWith('TODO');
        return (
          <a
            href={`/projects/${project.slug}/`}
            class="group rounded-lg border border-surface-200 bg-white p-5 transition-colors hover:border-primary-300 dark:border-surface-700 dark:bg-surface-900 dark:hover:border-primary-600"
          >
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900/30 dark:text-primary-300">
                {project.company}
              </span>
              {isTodo && (
                <span class="rounded bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
                  TODO
                </span>
              )}
            </div>
            <h4 class="mt-2 font-semibold text-surface-900 dark:text-surface-100">
              {project.title}
            </h4>
            <p class="mt-1.5 line-clamp-2 text-sm text-surface-600 dark:text-surface-400">
              {project.description}
            </p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {project.techStack.slice(0, 4).map((tech) => (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-600 dark:bg-surface-800 dark:text-surface-400">
                  {tech}
                </span>
              ))}
              {project.techStack.length > 4 && (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-600 dark:bg-surface-800 dark:text-surface-400">
                  +{project.techStack.length - 4}
                </span>
              )}
            </div>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary-600 transition-colors group-hover:text-primary-700 dark:text-primary-400 dark:group-hover:text-primary-300">
              View Details
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </span>
          </a>
        );
      })}
    </div>

    <h3 class="mb-4 mt-12 text-lg font-semibold text-surface-900 dark:text-surface-100">Independent Projects</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      {independentProjects.map((project) => {
        const isTodo = project.description.startsWith('TODO');
        return (
          <a
            href={`/projects/${project.slug}/`}
            class="group rounded-lg border border-surface-200 bg-white p-5 transition-colors hover:border-primary-300 dark:border-surface-700 dark:bg-surface-900 dark:hover:border-primary-600"
          >
            {isTodo && (
              <span class="rounded bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
                TODO
              </span>
            )}
            <h4 class:list={['font-semibold text-surface-900 dark:text-surface-100', !isTodo && 'mt-0']}>
              {project.title}
            </h4>
            <p class="mt-1.5 line-clamp-2 text-sm text-surface-600 dark:text-surface-400">
              {project.description}
            </p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {project.techStack.slice(0, 4).map((tech) => (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-600 dark:bg-surface-800 dark:text-surface-400">
                  {tech}
                </span>
              ))}
              {project.techStack.length > 4 && (
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-surface-600 dark:bg-surface-800 dark:text-surface-400">
                  +{project.techStack.length - 4}
                </span>
              )}
            </div>
            <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-primary-600 transition-colors group-hover:text-primary-700 dark:text-primary-400 dark:group-hover:text-primary-300">
              View Details
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
