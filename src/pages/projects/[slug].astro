---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MermaidDiagram from '../../components/MermaidDiagram.astro';
import ProjectText from '../../components/ProjectText.astro';
import { projects } from '../../data/projects';

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
};

const { project } = Astro.props;
const isTodo = project.description.startsWith('TODO');
const hasDiagrams = project.diagrams && project.diagrams.length > 0;
const hasImages = project.images && project.images.length > 0;
const hasChallenges = project.challenges && project.challenges.length > 0;
const sections = [
  { id: 'problem', label: 'Problem' },
  { id: 'my-role', label: 'My Role' },
  { id: 'approach', label: 'Architecture / Approach' },
  ...(hasDiagrams ? [{ id: 'diagrams', label: 'Architecture Diagrams' }] : []),
  ...(hasImages ? [{ id: 'screenshots', label: 'Screenshots' }] : []),
  { id: 'key-decisions', label: 'Key Decisions' },
  ...(hasChallenges ? [{ id: 'challenges', label: 'Challenges' }] : []),
  { id: 'result', label: 'Result' },
  { id: 'lessons', label: 'What I Learned' },
  ...(project.futureDirection ? [{ id: 'future-direction', label: 'Future Direction' }] : []),
];
const summaryItems = [
  { label: 'Problem', text: project.summary.problem },
  { label: 'My Role', text: project.summary.role },
  { label: 'Result', text: project.summary.result },
];
---

<BaseLayout
  noindex={isTodo}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Projects', url: '/projects/' }, { name: project.title, url: `/projects/${project.slug}/` }]}
  title={project.title}
  description={project.description}
>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a
      href="/projects/"
      class="inline-flex items-center gap-1 text-sm text-surface-500 transition-colors hover:text-surface-900 dark:text-surface-400 dark:hover:text-surface-100"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      Back to Projects
    </a>

    <div class="mt-6">
      <span class="rounded-full bg-primary-50 px-3 py-1 text-xs font-medium text-primary-700 dark:bg-primary-900/30 dark:text-primary-300">
        {project.company}
      </span>
      {isTodo && (
        <span class="ml-2 rounded bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">
          Needs Content
        </span>
      )}
    </div>

    <div class="mt-3 flex items-center gap-3">
      {project.icon && (
        <img
          src={project.icon}
          alt={`${project.title} icon`}
          class="h-10 w-10 shrink-0 rounded-xl sm:h-12 sm:w-12"
        />
      )}
      <h1 class="text-2xl font-bold text-surface-900 dark:text-surface-100 sm:text-3xl">
        {project.title}
      </h1>
    </div>

    <p class="mt-4 text-lg text-surface-600 dark:text-surface-400">
      {project.description}
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
      {project.techStack.map((tech) => (
        <span class="rounded-full border border-surface-200 px-3 py-1 text-xs text-surface-600 dark:border-surface-700 dark:text-surface-400">
          {tech}
        </span>
      ))}
    </div>

    {project.links && project.links.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-3">
        {project.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
          >
            {link.label}
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        ))}
      </div>
    )}

    <section aria-labelledby="summary-heading" class="mt-8 rounded-xl border border-surface-200 bg-surface-50 p-5 dark:border-surface-700 dark:bg-surface-900/50">
      <h2 id="summary-heading" class="text-lg font-semibold text-surface-900 dark:text-surface-100">At a Glance</h2>
      <dl class="mt-4 grid gap-5 sm:grid-cols-3">
        {summaryItems.map((item) => (
          <div>
            <dt class="text-sm font-semibold text-primary-700 dark:text-primary-300">{item.label}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-surface-600 dark:text-surface-400">{item.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <nav aria-label="On this page" class="my-8 border-y border-surface-200 py-5 dark:border-surface-700">
      <p class="text-sm font-semibold text-surface-900 dark:text-surface-100">On this page</p>
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
        {sections.map((section) => (
          <li><a href={`#${section.id}`} class="inline-block py-1 text-sm text-surface-600 underline decoration-surface-300 underline-offset-4 hover:text-primary-600 dark:text-surface-400 dark:decoration-surface-700 dark:hover:text-primary-400">{section.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="space-y-8">
      <section id="problem" class="scroll-mt-24">
        <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">Problem</h2>
        <ProjectText text={project.problem} bullets={project.bulletSections} />
      </section>

      <section id="my-role" class="scroll-mt-24">
        <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">My Role</h2>
        <ProjectText text={project.role} bullets={project.bulletSections} />
      </section>

      <section id="approach" class="scroll-mt-24">
        <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">Architecture / Approach</h2>
        <ProjectText text={project.approach} bullets={project.bulletSections} />
        {project.keyDesign.length > 0 && (
          <ul class="mt-3 list-inside list-disc space-y-1.5 text-surface-600 dark:text-surface-400">
            {project.keyDesign.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>

      {hasDiagrams && (
        <section id="diagrams" class="scroll-mt-24">
          <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">Architecture Diagrams</h2>
          {project.diagrams!.map((diagram) => (
            <MermaidDiagram chart={diagram.mermaid} title={diagram.title} />
          ))}
        </section>
      )}

      {hasImages && (
        <section id="screenshots" class="scroll-mt-24">
          <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">Screenshots</h2>
          <div class="mt-6 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
            {project.images!.map((image) => (
              <figure class="flex flex-col items-center">
                <div class="phone-frame">
                  <img
                    src={image.src}
                    alt={image.alt}
                    loading="lazy"
                  />
                </div>
                {image.caption && (
                  <figcaption class="mt-3 text-center text-xs leading-relaxed text-surface-500 dark:text-surface-400">
                    {image.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </section>
      )}

      <section id="key-decisions" class="scroll-mt-24">
        <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">Key Decisions</h2>
        <ul class="mt-2 list-inside list-disc space-y-1.5 text-surface-600 dark:text-surface-400">
          {project.keyDecisions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      {hasChallenges && (
        <section id="challenges" class="scroll-mt-24">
          <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">Challenges</h2>
          <ul class="mt-2 list-inside list-disc space-y-1.5 text-surface-600 dark:text-surface-400">
            {project.challenges!.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}

      <section id="result" class="scroll-mt-24">
        <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">Result</h2>
        <ProjectText text={project.result} bullets={project.bulletSections} />
      </section>

      <section id="lessons" class="scroll-mt-24">
        <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">What I Learned</h2>
        <ProjectText text={project.learned} bullets={project.bulletSections} />
      </section>
      {project.futureDirection && (
        <section id="future-direction" class="scroll-mt-24">
          <h2 class="text-lg font-semibold text-surface-900 dark:text-surface-100">Future Direction</h2>
          {project.futureDiagram && (
            <MermaidDiagram chart={project.futureDiagram.mermaid} title={project.futureDiagram.title} />
          )}
          <ProjectText text={project.futureDirection} bullets={project.bulletSections} />
        </section>
      )}
    </div>

    <hr class="my-8 border-surface-200 dark:border-surface-700" />

    <a
      href="/projects/"
      class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      Back to Projects
    </a>
  </article>
</BaseLayout>
