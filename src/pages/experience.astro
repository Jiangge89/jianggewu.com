---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { experiences, education } from '../data/experience';
---

<BaseLayout
  title="Experience"
  description="Professional experience of Jiangge Wu — backend engineering roles at TikTok, Shopee, and Works Applications in Singapore."
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <SectionHeading
      title="Experience"
      subtitle="My professional journey in software engineering."
    />

    <div>
      {experiences.map((exp) => (
        <ExperienceItem experience={exp} />
      ))}
    </div>
  </section>

  <section class="border-t border-surface-100 dark:border-surface-800">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <SectionHeading title="Education" />

      <div class="space-y-6">
        {education.map((edu) => (
          <div class="rounded-lg border border-surface-200 p-5 dark:border-surface-700">
            <h3 class="font-semibold text-surface-900 dark:text-surface-100">{edu.degree}</h3>
            <p class="mt-1 text-sm font-medium text-primary-600 dark:text-primary-400">
              {edu.institution} &middot; {edu.location}
            </p>
            <div class="mt-2 flex items-center justify-between">
              <span class="text-sm text-surface-500 dark:text-surface-400">
                {edu.startDate} &mdash; {edu.endDate}
              </span>
              <span class="text-sm text-surface-600 dark:text-surface-400">
                GPA: {edu.gpa}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
