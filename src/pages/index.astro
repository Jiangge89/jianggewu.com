---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SystemFlow from '../components/SystemFlow.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { experiences } from '../data/experience';

const featuredProjects = projects.filter((p) => p.featured);
const primaryTechnologies = ['Go', 'Java', 'Python', 'Distributed Systems', 'Redis', 'Kafka', 'MySQL', 'Docker'];

const impactMetrics = [
  { value: '10+', label: 'years in backend engineering', href: '/experience/' },
  { value: '~160k', label: 'metadata reads/s per region', href: '/projects/tos-metadata-control-plane/' },
  { value: 'Zero', label: 'downtime across dozens of regions', href: '/projects/rds-to-kv-online-migration/' },
  { value: '~60k', label: 'buckets under quota automation', href: '/projects/quota-automation-traffic-governance/' },
];
---

<BaseLayout>
  {/* Hero */}
  <div class="relative isolate overflow-hidden">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="flex flex-col items-center gap-10 sm:flex-row sm:items-start sm:gap-16">
      <div class="flex-1">
        <div class="animate-fade-up flex flex-wrap items-center gap-3">
          <p class="text-sm font-medium uppercase tracking-wider text-primary-600 dark:text-primary-400">
            {siteConfig.role} &middot; {siteConfig.location}
          </p>
          <a
            href="/contact/"
            class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50/80 px-2.5 py-0.5 text-xs font-medium text-emerald-700 transition-colors hover:bg-emerald-100 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300 dark:hover:bg-emerald-950/70"
          >
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            Open to new roles
          </a>
        </div>
        <h1 class="animate-fade-up mt-3 text-3xl font-bold text-surface-900 dark:text-surface-100 sm:text-4xl lg:text-5xl" style="animation-delay: 0.08s">
          Hi, I'm {siteConfig.name}.
        </h1>
        <p class="animate-fade-up mt-4 text-xl font-medium leading-snug text-surface-800 dark:text-surface-200" style="animation-delay: 0.16s">
          10+ years in backend engineering. Built globally distributed systems at TikTok and Shopee, with experience supporting workloads exceeding 100k QPS.
        </p>
        <p class="animate-fade-up mt-4 text-lg leading-relaxed text-surface-600 dark:text-surface-400" style="animation-delay: 0.24s">
          I specialize in metadata platforms, distributed storage, caching infrastructure, and online migration — and build independent iOS products and AI-integrated apps on the side.
        </p>

        {/* Tech stack */}
        <div class="animate-fade-up mt-8 flex flex-wrap gap-2" style="animation-delay: 0.32s">
          {primaryTechnologies.map((tech) => (
            <span class="rounded-full border border-surface-200 px-3 py-1 text-sm text-surface-700 dark:border-surface-700 dark:text-surface-300">
              {tech}
            </span>
          ))}
        </div>

        {/* CTAs */}
        <div class="animate-fade-up mt-8 flex flex-wrap gap-4" style="animation-delay: 0.38s">
          <a
            href="/projects/"
            class="inline-flex items-center rounded-md bg-primary-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-700"
          >
            View Projects
          </a>
          <a
            href={siteConfig.resumePath}
            download
            class="inline-flex items-center rounded-md border border-surface-300 bg-white px-5 py-2.5 text-sm font-medium text-surface-700 transition-colors hover:bg-surface-50 dark:border-surface-600 dark:bg-surface-800 dark:text-surface-300 dark:hover:bg-surface-700"
          >
            Download Resume
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center rounded-md border border-surface-300 bg-white px-5 py-2.5 text-sm font-medium text-surface-700 transition-colors hover:bg-surface-50 dark:border-surface-600 dark:bg-surface-800 dark:text-surface-300 dark:hover:bg-surface-700"
          >
            Contact Me
          </a>
        </div>
      </div>

      <div class="animate-scale-in shrink-0 rounded-full bg-linear-to-br from-primary-400/70 via-primary-200/40 to-transparent p-1.5 dark:from-primary-500/60 dark:via-primary-800/30" style="animation-delay: 0.2s">
        <Image
          src={avatar}
          alt={siteConfig.name}
          width={256}
          height={256}
          widths={[192, 256, 384, 512, 768]}
          sizes="(min-width: 1024px) 256px, (min-width: 640px) 224px, 192px"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          class="h-48 w-48 rounded-full border-4 border-white object-cover shadow-xl dark:border-surface-950 sm:h-56 sm:w-56 lg:h-64 lg:w-64"
        />
      </div>
    </div>
  </section>
  </div>

  {/* Systems */}
  <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
    <div class="reveal">
      <SectionHeading
        title="Systems I've built"
        subtitle="A live sketch of the metadata read path I owned at TikTok. Switch scenarios to see how it behaves under pressure."
      />
    </div>
    <div class="reveal" style="transition-delay: 0.1s">
      <SystemFlow />
    </div>
    <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {impactMetrics.map((m, i) => (
        <a
          href={m.href}
          class="reveal group rounded-xl border border-surface-200 bg-white/70 p-4 backdrop-blur-sm transition-colors hover:border-primary-300 dark:border-surface-800 dark:bg-surface-900/50 dark:hover:border-primary-700"
          style={`transition-delay: ${0.15 + i * 0.08}s`}
        >
          <p class="text-2xl font-bold tracking-tight text-surface-900 group-hover:text-primary-700 dark:text-surface-100 dark:group-hover:text-primary-300 sm:text-3xl">
            {m.value}
          </p>
          <p class="mt-1 text-sm leading-snug text-surface-600 dark:text-surface-400">{m.label}</p>
        </a>
      ))}
    </div>
  </section>

  {/* Featured Projects */}
  <section class="border-t border-surface-100 bg-surface-50 dark:border-surface-800 dark:bg-surface-900/50">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <div class="reveal">
        <SectionHeading title="Featured Projects" subtitle="Selected work that represents my technical focus." />
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {featuredProjects.map((project, i) => (
          <div class="reveal" style={`transition-delay: ${0.1 + i * 0.12}s`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
      <div class="reveal mt-8 text-center" style="transition-delay: 0.4s">
        <a
          href="/projects/"
          class="text-sm font-medium text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
        >
          View all projects &rarr;
        </a>
      </div>
    </div>
  </section>

  {/* Experience Overview */}
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="reveal">
      <SectionHeading title="Experience" subtitle="A brief overview of my professional background." />
    </div>
    <div class="space-y-4">
      {experiences.map((exp, i) => (
        <div class="reveal flex items-center gap-4 rounded-lg border border-surface-200 p-4 dark:border-surface-700" style={`transition-delay: ${0.08 + i * 0.1}s`}>
          {exp.logo && (
            <div class="flex h-12 w-16 shrink-0 items-center justify-center sm:w-20">
              <img
                src={exp.logo}
                alt={`${exp.company} logo`}
                loading="lazy"
                decoding="async"
                class="max-h-12 max-w-full object-contain"
              />
            </div>
          )}
          <div class="min-w-0 flex-1 sm:flex sm:items-center sm:justify-between">
            <div>
              <h3 class="font-semibold text-surface-900 dark:text-surface-100">{exp.role}</h3>
              <p class="text-sm text-surface-600 dark:text-surface-400">
                {exp.company} &middot; {exp.location}
              </p>
            </div>
            <span class="mt-1 block text-sm text-surface-500 dark:text-surface-400 sm:mt-0 sm:shrink-0">
              {exp.startDate} &mdash; {exp.endDate}
            </span>
          </div>
        </div>
      ))}
    </div>
    <div class="reveal mt-6 text-center" style="transition-delay: 0.3s">
      <a
        href="/experience/"
        class="text-sm font-medium text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
      >
        View full experience &rarr;
      </a>
    </div>
  </section>

  {/* Contact CTA */}
  <section class="border-t border-surface-100 bg-surface-50 dark:border-surface-800 dark:bg-surface-900/50">
    <div class="reveal mx-auto max-w-5xl px-4 py-16 text-center sm:px-6">
      <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-100">Let's Connect</h2>
      <p class="mt-3 text-surface-600 dark:text-surface-400">
        I'm open to new opportunities, collaborations, and conversations about backend engineering and product development.
      </p>
      <a
        href="/contact/"
        class="mt-6 inline-flex items-center rounded-md bg-primary-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-700"
      >
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
