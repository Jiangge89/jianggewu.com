---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { siteConfig } from '../config/site';
import { projects } from '../data/projects';
import { experiences } from '../data/experience';

const featuredProjects = projects.filter((p) => p.featured);
const primaryTechnologies = ['Go', 'Java', 'Python', 'Distributed Systems', 'Redis', 'Kafka', 'MySQL', 'Docker'];
---

<BaseLayout>
  {/* Hero */}
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="flex flex-col items-center gap-10 sm:flex-row sm:items-start sm:gap-16">
      <div class="flex-1">
        <p class="text-sm font-medium uppercase tracking-wider text-primary-600 dark:text-primary-400">
          {siteConfig.role} &middot; {siteConfig.location}
        </p>
        <h1 class="mt-3 text-3xl font-bold text-surface-900 dark:text-surface-100 sm:text-4xl lg:text-5xl">
          Hi, I'm {siteConfig.name}.
        </h1>
        <p class="mt-4 text-xl font-medium leading-snug text-surface-800 dark:text-surface-200">
          10+ years in backend engineering. Built globally distributed systems at TikTok and Shopee, with experience supporting workloads exceeding 100k QPS.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-surface-600 dark:text-surface-400">
          I specialize in metadata platforms, distributed storage, caching infrastructure, and online migration — and build independent iOS products and AI-integrated apps on the side.
        </p>

        {/* Tech stack */}
        <div class="mt-8 flex flex-wrap gap-2">
          {primaryTechnologies.map((tech) => (
            <span class="rounded-full border border-surface-200 px-3 py-1 text-sm text-surface-700 dark:border-surface-700 dark:text-surface-300">
              {tech}
            </span>
          ))}
        </div>

        {/* CTAs */}
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/projects/"
            class="inline-flex items-center rounded-md bg-primary-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-700"
          >
            View Projects
          </a>
          <a
            href={siteConfig.resumePath}
            download
            class="inline-flex items-center rounded-md border border-surface-300 bg-white px-5 py-2.5 text-sm font-medium text-surface-700 transition-colors hover:bg-surface-50 dark:border-surface-600 dark:bg-surface-800 dark:text-surface-300 dark:hover:bg-surface-700"
          >
            Download Resume
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center rounded-md border border-surface-300 bg-white px-5 py-2.5 text-sm font-medium text-surface-700 transition-colors hover:bg-surface-50 dark:border-surface-600 dark:bg-surface-800 dark:text-surface-300 dark:hover:bg-surface-700"
          >
            Contact Me
          </a>
        </div>
      </div>

      <div class="shrink-0">
        <Image
          src={avatar}
          alt={siteConfig.name}
          width={256}
          height={256}
          widths={[192, 256, 384, 512, 768]}
          sizes="(min-width: 1024px) 256px, (min-width: 640px) 224px, 192px"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          class="h-48 w-48 rounded-full object-cover shadow-lg sm:h-56 sm:w-56 lg:h-64 lg:w-64"
        />
      </div>
    </div>
  </section>

  {/* Featured Projects */}
  <section class="border-t border-surface-100 bg-surface-50 dark:border-surface-800 dark:bg-surface-900/50">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <SectionHeading title="Featured Projects" subtitle="Selected work that represents my technical focus." />
      <div class="grid gap-6 sm:grid-cols-2">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="mt-8 text-center">
        <a
          href="/projects/"
          class="text-sm font-medium text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
        >
          View all projects &rarr;
        </a>
      </div>
    </div>
  </section>

  {/* Experience Overview */}
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <SectionHeading title="Experience" subtitle="A brief overview of my professional background." />
    <div class="space-y-4">
      {experiences.map((exp) => (
        <div class="flex items-center gap-4 rounded-lg border border-surface-200 p-4 dark:border-surface-700">
          {exp.logo && (
            <div class="flex h-12 w-16 shrink-0 items-center justify-center sm:w-20">
              <img
                src={exp.logo}
                alt={`${exp.company} logo`}
                loading="lazy"
                decoding="async"
                class="max-h-12 max-w-full object-contain"
              />
            </div>
          )}
          <div class="min-w-0 flex-1 sm:flex sm:items-center sm:justify-between">
            <div>
              <h3 class="font-semibold text-surface-900 dark:text-surface-100">{exp.role}</h3>
              <p class="text-sm text-surface-600 dark:text-surface-400">
                {exp.company} &middot; {exp.location}
              </p>
            </div>
            <span class="mt-1 block text-sm text-surface-500 dark:text-surface-400 sm:mt-0 sm:shrink-0">
              {exp.startDate} &mdash; {exp.endDate}
            </span>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-6 text-center">
      <a
        href="/experience/"
        class="text-sm font-medium text-primary-600 transition-colors hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
      >
        View full experience &rarr;
      </a>
    </div>
  </section>

  {/* Contact CTA */}
  <section class="border-t border-surface-100 bg-surface-50 dark:border-surface-800 dark:bg-surface-900/50">
    <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6">
      <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-100">Let's Connect</h2>
      <p class="mt-3 text-surface-600 dark:text-surface-400">
        I'm open to new opportunities, collaborations, and conversations about backend engineering and product development.
      </p>
      <a
        href="/contact/"
        class="mt-6 inline-flex items-center rounded-md bg-primary-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-primary-700"
      >
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
