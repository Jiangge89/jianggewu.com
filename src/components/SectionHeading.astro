---
interface Props {
  title: string;
  subtitle?: string;
  as?: 'h1' | 'h2';
}

const { title, subtitle, as: Tag = 'h2' } = Astro.props;
---

<div class="mb-8">
  <Tag class="text-2xl font-bold text-surface-900 dark:text-surface-100 sm:text-3xl">{title}</Tag>
  {subtitle && <p class="mt-2 text-surface-600 dark:text-surface-400">{subtitle}</p>}
</div>
