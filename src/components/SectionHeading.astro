---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-8">
  <h2 class="text-2xl font-bold text-surface-900 dark:text-surface-100 sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-2 text-surface-600 dark:text-surface-400">{subtitle}</p>}
</div>
