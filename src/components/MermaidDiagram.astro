---
interface Props {
  chart: string;
  title?: string;
}

const { chart, title } = Astro.props;
---

<div class="mermaid-wrapper my-6 overflow-x-auto rounded-lg border border-surface-200 bg-surface-50 p-4 dark:border-surface-700 dark:bg-surface-800/50">
  {title && (
    <p class="mb-3 text-sm font-medium text-surface-500 dark:text-surface-400">{title}</p>
  )}
  <pre class="mermaid text-center">{chart}</pre>
</div>

<script>
  async function initMermaid() {
    const elements = document.querySelectorAll('pre.mermaid');
    if (elements.length === 0) return;

    const { default: mermaid } = await import('mermaid');
    const isDark = document.documentElement.classList.contains('dark');
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      flowchart: { useMaxWidth: true, htmlLabels: true },
      securityLevel: 'loose',
    });
    await mermaid.run({ nodes: elements });
  }

  initMermaid();
  document.addEventListener('astro:after-swap', initMermaid);
</script>
