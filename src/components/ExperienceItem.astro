---
import type { Experience } from '../data/experience';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
const isTodo = experience.company.startsWith('TODO');
---

<div class="relative border-l-2 border-surface-200 pl-6 dark:border-surface-700">
  <div class="absolute -left-[9px] top-0 h-4 w-4 rounded-full border-2 border-primary-500 bg-white dark:bg-surface-950"></div>

  <div class="pb-8">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
      <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-100">
        {experience.role}
        {isTodo && <span class="ml-2 rounded bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">TODO</span>}
      </h3>
      <span class="text-sm text-surface-500 dark:text-surface-400">
        {experience.startDate} &mdash; {experience.endDate}
      </span>
    </div>

    <p class="mt-1 text-sm font-medium text-primary-600 dark:text-primary-400">
      {experience.company} &middot; {experience.location}
    </p>

    <p class="mt-3 text-surface-600 dark:text-surface-400">{experience.summary}</p>

    {experience.responsibilities.length > 0 && (
      <div class="mt-3">
        <h4 class="text-sm font-semibold text-surface-700 dark:text-surface-300">Responsibilities</h4>
        <ul class="mt-1 list-inside list-disc space-y-1 text-sm text-surface-600 dark:text-surface-400">
          {experience.responsibilities.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )}

    {experience.achievements.length > 0 && (
      <div class="mt-3">
        <h4 class="text-sm font-semibold text-surface-700 dark:text-surface-300">Achievements</h4>
        <ul class="mt-1 list-inside list-disc space-y-1 text-sm text-surface-600 dark:text-surface-400">
          {experience.achievements.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )}

    <div class="mt-3 flex flex-wrap gap-2">
      {experience.technologies.map((tech) => (
        <span class="rounded-full bg-surface-100 px-3 py-1 text-xs font-medium text-surface-700 dark:bg-surface-800 dark:text-surface-300">
          {tech}
        </span>
      ))}
    </div>
  </div>
</div>
