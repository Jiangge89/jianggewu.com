---
import Butterfly from './Butterfly.astro';

const techs = ['Go', 'Redis', 'Kafka', 'Docker', 'Java', 'Python', 'MySQL', 'K8s', 'gRPC', 'Linux'];
---

<div id="cosmos" aria-hidden="true">
  <canvas id="starfield-cv"></canvas>
  {techs.map((tech, i) => (
    <span class="cnode" data-i={String(i)}>{tech}</span>
  ))}
  <div class="butterfly-flight" id="butterfly-flight"><Butterfly /></div>
</div>

<style>
  #cosmos {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  #starfield-cv {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .cnode {
    position: absolute;
    left: 0;
    top: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    will-change: transform, opacity;
    pointer-events: none;
    user-select: none;
    color: var(--color-surface-400);
  }

  .cnode.visible {
    opacity: 0.1;
  }

  .cnode.attracted {
    opacity: 0.55;
    color: var(--color-primary-500);
  }

  :where(.dark) .cnode.visible {
    opacity: 0.2;
    color: var(--color-primary-400);
  }

  :where(.dark) .cnode.attracted {
    opacity: 0.75;
    color: var(--color-primary-300);
    text-shadow: 0 0 12px rgba(96, 165, 250, 0.4);
  }
</style>

<script>
  function initCosmos() {
    const container = document.getElementById('cosmos');
    const canvas = document.getElementById('starfield-cv') as HTMLCanvasElement;
    if (!container || !canvas) return;

    const ctx = canvas.getContext('2d')!;
    const nodeEls = Array.from(container.querySelectorAll('.cnode')) as HTMLElement[];

    function mulberry32(a: number) {
      return () => {
        a |= 0; a = a + 0x6D2B79F5 | 0;
        let t = Math.imul(a ^ a >>> 15, 1 | a);
        t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
        return ((t ^ t >>> 14) >>> 0) / 4294967296;
      };
    }

    const homes: [number, number][] = [
      [0.04, 0.13], [0.93, 0.09], [0.06, 0.43], [0.95, 0.36],
      [0.03, 0.71], [0.91, 0.66], [0.05, 0.89], [0.94, 0.86],
      [0.32, 0.04], [0.70, 0.96],
    ];

    const state = nodeEls.map((el, i) => ({
      el,
      hx: homes[i]?.[0] ?? 0.5,
      hy: homes[i]?.[1] ?? 0.5,
      x: 0,
      y: 0,
      attached: false,
    }));

    let mouseX = -9999;
    let mouseY = -9999;
    let vw = 0;
    let vh = 0;
    let rafId = 0;
    let stars: { x: number; y: number; r: number; a: number; twinkle: boolean }[] = [];
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function generateStars() {
      const rand = mulberry32(7);
      const count = Math.min(Math.floor((vw * vh) / 6000), 350);
      stars = [];
      for (let i = 0; i < count; i++) {
        stars.push({
          x: rand() * vw,
          y: rand() * vh,
          r: rand() * 1.3 + 0.2,
          a: rand() * 0.5 + 0.15,
          twinkle: rand() > 0.65,
        });
      }
    }

    function drawStars(time: number) {
      const isDark = document.documentElement.classList.contains('dark');
      ctx.clearRect(0, 0, vw, vh);

      for (const s of stars) {
        let alpha = s.a;
        if (s.twinkle && !prefersReduced) {
          alpha *= 0.4 + 0.6 * Math.sin(time * 0.0008 + s.x * 0.05 + s.y * 0.03);
        }
        alpha *= isDark ? 1 : 0.12;

        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r * (isDark ? 1 : 0.6), 0, Math.PI * 2);
        ctx.fillStyle = isDark
          ? `rgba(175, 200, 255, ${alpha})`
          : `rgba(110, 130, 170, ${alpha})`;
        ctx.fill();
      }
    }

    function resize() {
      vw = window.innerWidth;
      vh = window.innerHeight;
      const dpr = Math.min(devicePixelRatio, 2);
      canvas.width = vw * dpr;
      canvas.height = vh * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      generateStars();

      for (const s of state) {
        s.x = s.hx * vw;
        s.y = s.hy * vh;
        s.el.style.transform = `translate(${s.x}px, ${s.y}px)`;
        s.el.classList.add('visible');
      }
    }

    const ATTRACT_R = 160;
    const RELEASE_R = 210;

    function tick(time: number) {
      rafId = requestAnimationFrame(tick);
      drawStars(time);

      if (prefersReduced) return;

      for (const s of state) {
        const idx = parseInt(s.el.dataset.i!);
        const hx = s.hx * vw;
        const hy = s.hy * vh;

        // Gentle float at home
        const floatY = Math.sin(time * 0.0006 + idx * 1.8) * 6;
        const floatX = Math.cos(time * 0.0004 + idx * 2.3) * 3;

        const dxH = mouseX - hx;
        const dyH = mouseY - hy;
        const distH = Math.sqrt(dxH * dxH + dyH * dyH);

        if (!s.attached && distH < ATTRACT_R) s.attached = true;
        else if (s.attached && distH > RELEASE_R) s.attached = false;

        let tx: number, ty: number, lerp: number;

        if (s.attached) {
          // Orbit around cursor
          const angle = (idx / nodeEls.length) * Math.PI * 2 + time * 0.0004;
          const orbitR = 22 + (idx % 3) * 10;
          tx = mouseX + Math.cos(angle) * orbitR;
          ty = mouseY + Math.sin(angle) * orbitR;
          lerp = 0.09;
        } else {
          tx = hx + floatX;
          ty = hy + floatY;
          lerp = 0.04;
        }

        const dx = tx - s.x;
        const dy = ty - s.y;

        if (Math.abs(dx) > 0.05 || Math.abs(dy) > 0.05) {
          s.x += dx * lerp;
          s.y += dy * lerp;
          s.el.style.transform = `translate(${s.x}px, ${s.y}px)`;
        }

        s.el.classList.toggle('attracted', s.attached);
      }
    }

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    document.addEventListener('mouseleave', () => {
      mouseX = -9999;
      mouseY = -9999;
    });

    // Touch support
    document.addEventListener('touchmove', (e) => {
      mouseX = e.touches[0].clientX;
      mouseY = e.touches[0].clientY;
    }, { passive: true });

    document.addEventListener('touchend', () => {
      mouseX = -9999;
      mouseY = -9999;
    });

    window.addEventListener('resize', resize);

    resize();
    rafId = requestAnimationFrame(tick);
    scheduleButterfly(prefersReduced);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(rafId);
      clearTimeout(butterflyTimer);
    }, { once: true });
  }

  // A dark-violet butterfly crosses the night sky now and then: first a few
  // seconds after arrival, then every 3-5 minutes while the visitor stays.
  // It only flies in dark mode with the tab in front; otherwise it checks
  // again shortly. The schedule lives in sessionStorage so navigating
  // between pages neither resets it nor makes it fly early.
  const NEXT_KEY = 'butterfly-next-at';
  const FIRST_DELAY_MS: [number, number] = [6_000, 16_000];
  const INTERVAL_MS: [number, number] = [180_000, 300_000];
  const RETRY_MS = 20_000;

  let butterflyTimer = 0;
  let memoryNextAt = 0; // Fallback when storage is blocked.

  const between = (min: number, max: number) => min + Math.random() * (max - min);

  function readNextAt() {
    try {
      const stored = Number(sessionStorage.getItem(NEXT_KEY));
      if (stored) return stored;
    } catch {
      // Fall through to the in-memory value.
    }
    return memoryNextAt;
  }

  function writeNextAt(time: number) {
    memoryNextAt = time;
    try {
      sessionStorage.setItem(NEXT_KEY, String(time));
    } catch {
      // In-memory value still works within this page.
    }
  }

  function scheduleButterfly(prefersReduced: boolean) {
    clearTimeout(butterflyTimer);
    if (prefersReduced) return;
    let nextAt = readNextAt();
    if (!nextAt) {
      nextAt = Date.now() + between(...FIRST_DELAY_MS);
      writeNextAt(nextAt);
    }
    // Never launch the instant a page appears.
    const delay = Math.max(nextAt - Date.now(), between(3_000, 8_000));
    butterflyTimer = window.setTimeout(tryFlight, delay);
  }

  function tryFlight() {
    const el = document.getElementById('butterfly-flight');
    if (!el) return;
    const isDark = document.documentElement.classList.contains('dark');
    if (!isDark || document.hidden) {
      butterflyTimer = window.setTimeout(tryFlight, RETRY_MS);
      return;
    }
    flyButterfly(el);
    const interval = between(...INTERVAL_MS);
    writeNextAt(Date.now() + interval);
    butterflyTimer = window.setTimeout(tryFlight, interval);
  }

  // The path has a clear heading from one edge to a point higher on the
  // other, but wanders around it the way butterflies do: slow sideways
  // drifts, a quick bob with each wingbeat, and moments where it lingers
  // before pushing on.
  function flyButterfly(el: HTMLElement) {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const rtl = Math.random() < 0.5;
    const margin = 50;
    const y0 = vh * between(0.3, 0.75);
    const y1 = y0 - vh * between(0.1, 0.3);
    const sx = rtl ? vw + margin : -margin;
    const ex = rtl ? -margin : vw + margin;
    const dx = ex - sx;
    const dy = y1 - y0;
    const len = Math.hypot(dx, dy);
    const nx = -dy / len;
    const ny = dx / len;

    const TAU = Math.PI * 2;
    const drift = { a: vh * between(0.05, 0.08), f: between(1.1, 1.6), p: Math.random() * TAU };
    const sway = { a: vh * between(0.02, 0.035), f: between(2.6, 3.4), p: Math.random() * TAU };
    const bob = { a: between(5, 9), f: between(16, 22), p: Math.random() * TAU };
    const lingers = Math.random() < 0.5 ? 2 : 3;

    // Monotonic time warp: progress along the main line slows down
    // `lingers` times but never reverses.
    const progress = (t: number) => t + (0.55 * Math.sin(TAU * lingers * t)) / (TAU * lingers);

    const position = (t: number, withBob: boolean) => {
      const envelope = Math.sin(Math.PI * t);
      let offset =
        drift.a * Math.sin(TAU * drift.f * t + drift.p) +
        sway.a * Math.sin(TAU * sway.f * t + sway.p);
      if (withBob) offset += bob.a * Math.sin(TAU * bob.f * t + bob.p);
      offset *= envelope;
      const s = progress(t);
      return [sx + dx * s + nx * offset, y0 + dy * s + ny * offset];
    };

    const steps = 90;
    const keyframes = [];
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const [x, y] = position(t, true);
      const [ax, ay] = position(Math.max(t - 0.01, 0), false);
      const [bx, by] = position(Math.min(t + 0.01, 1), false);
      const heading = (Math.atan2(by - ay, bx - ax) * 180) / Math.PI + 90;
      const tilt = 8 * Math.sin(TAU * 9 * t);
      const opacity = 0.7 * Math.min(1, t / 0.04, (1 - t) / 0.04);
      keyframes.push({
        transform: `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) rotate(${(heading + tilt).toFixed(1)}deg)`,
        opacity,
      });
    }

    el.animate(keyframes, {
      duration: Math.min(22_000, Math.max(13_000, len * 13)),
      easing: 'linear',
      fill: 'forwards',
    });
  }

  initCosmos();
  document.addEventListener('astro:after-swap', initCosmos);
</script>
