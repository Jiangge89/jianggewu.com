---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  showDetails?: boolean;
}

const { project, showDetails = false } = Astro.props;
const isTodo = project.description.startsWith('TODO');
---

<article class="rounded-lg border border-surface-200 bg-white p-6 transition-colors hover:border-primary-300 dark:border-surface-700 dark:bg-surface-900 dark:hover:border-primary-600">
  <h3 class="text-lg font-semibold text-surface-900 dark:text-surface-100">
    {project.title}
    {isTodo && <span class="ml-2 rounded bg-yellow-100 px-2 py-0.5 text-xs font-medium text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">Needs Content</span>}
  </h3>

  <p class="mt-2 text-surface-600 dark:text-surface-400">{project.description}</p>

  <div class="mt-4 flex flex-wrap gap-2">
    {project.techStack.map((tech) => (
      <span class="rounded-full bg-primary-50 px-3 py-1 text-xs font-medium text-primary-700 dark:bg-primary-900/30 dark:text-primary-300">
        {tech}
      </span>
    ))}
  </div>

  {showDetails && (
    <div class="mt-6 space-y-4 border-t border-surface-200 pt-4 dark:border-surface-700">
      <div>
        <h4 class="text-sm font-semibold text-surface-900 dark:text-surface-100">Problem</h4>
        <p class="mt-1 text-sm text-surface-600 dark:text-surface-400">{project.problem}</p>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-surface-900 dark:text-surface-100">My Role</h4>
        <p class="mt-1 text-sm text-surface-600 dark:text-surface-400">{project.role}</p>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-surface-900 dark:text-surface-100">Architecture / Approach</h4>
        <p class="mt-1 text-sm text-surface-600 dark:text-surface-400">{project.approach}</p>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-surface-900 dark:text-surface-100">Key Decisions</h4>
        <ul class="mt-1 list-inside list-disc space-y-1 text-sm text-surface-600 dark:text-surface-400">
          {project.keyDecisions.map((decision) => (
            <li>{decision}</li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-surface-900 dark:text-surface-100">Result</h4>
        <p class="mt-1 text-sm text-surface-600 dark:text-surface-400">{project.result}</p>
      </div>
      <div>
        <h4 class="text-sm font-semibold text-surface-900 dark:text-surface-100">What I Learned</h4>
        <p class="mt-1 text-sm text-surface-600 dark:text-surface-400">{project.learned}</p>
      </div>
    </div>
  )}
</article>
