---
import type { TextBlock } from '../data/projects';

interface Props {
  text: TextBlock;
  bullets?: boolean;
}

const { text, bullets = false } = Astro.props;
const items = Array.isArray(text) ? text : [text];
---

{bullets ? (
  <ul class="mt-2 list-outside list-disc space-y-2 pl-5 leading-relaxed text-surface-600 dark:text-surface-400">
    {items.map((item) => (
      <li>
        {typeof item !== 'string' ? (
          <>
            <strong>{item.title}</strong>
            <ul class="mt-2 list-outside list-disc space-y-2 pl-5">
              {item.items.map((point) => (
                <li>
                  {point.includes(':') ? (
                    <><strong>{point.slice(0, point.indexOf(':') + 1)}</strong>{point.slice(point.indexOf(':') + 1)}</>
                  ) : point}
                </li>
              ))}
            </ul>
          </>
        ) : item.includes(':') ? (
          <><strong>{item.slice(0, item.indexOf(':') + 1)}</strong>{item.slice(item.indexOf(':') + 1)}</>
        ) : item}
      </li>
    ))}
  </ul>
) : items.map((item, i) => (
  typeof item === 'string' ? (
    <p class={`${i === 0 ? 'mt-2' : 'mt-3'} leading-relaxed text-surface-600 dark:text-surface-400`}>{item}</p>
  ) : (
    <div class="mt-3">
      <h3 class="font-semibold text-surface-600 dark:text-surface-400">{item.title}</h3>
      <ul class="mt-2 list-outside list-disc space-y-2 pl-5 leading-relaxed text-surface-600 dark:text-surface-400">
        {item.items.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  )
))}
